/* Lexical Parser */

!whitespace : '\t' | '\n' | '\r' | ' ' ;
!lineComment : '/' '/' { . } '\n' ;
!blockComment : '/' '*' { . | '*' } '*' '/' ;

_letter : 'A'-'Z' | 'a'-'z' | '_' ;
_digit : '0'-'9' ;
_alpha : _letter | _digit ;

/* literals */
string_literal : '"' {_alpha | ' ' | '!' | '?' | ':' | ',' | '.' }'"' ;
int : '0' | '1'-'9' {_digit} ;

/* keywords */
test : 'T' 'E' 'S' 'T' ;
given : 'G' 'I' 'V' 'E' 'N' ;
as : 'A' 'S' ;
object: 'O' 'B' 'J' 'E' 'C' 'T' ;
call : 'C' 'A' 'L' 'L' ;
then : 'T' 'H' 'E' 'N' ;
output : 'O' 'U' 'T' 'P' 'U' 'T' ;
result : 'R' 'E' 'S' 'U' 'L' 'T' ;
equals : 'E' 'Q' 'U' 'A' 'L' 'S' ;
not_equals : 'N' 'O' 'T' ' ' 'E' 'Q' 'U' 'A' 'L' 'S' ;
contains : 'C' 'O' 'N' 'T' 'A' 'I' 'N' 'S' ;

/* identifiers */
ident : _letter {_alpha} ;

/* punctuation */
lbrace : '{' ;
rbrace : '}' ;
lparen : '(' ;
rparen : ')' ;
comma : ',' ;
colon : ':' ;
semicolon : ';' ;
dot : '.' ;

/* Syntactic Parser */

Configuration
    : TestDefinitions GlobalDefinitions
    ;

TestDefinitions
    : TestDefinitions TestDefinition
    | empty
    ;

GlobalDefinitions
    : GlobalDefinitions GlobalDefinition
    | empty
    ;

GlobalDefinition
    : Expression semicolon
    ;

TestDefinition
    : test string_literal GivenBlock CallBlock ThenBlock semicolon
    ;

GivenBlock
    : given GivenExpressions
    | empty
    ;

GivenExpressions
    : GivenExpressions comma Expression
    | Expression
    ;

Object
    : object ident lbrace ObjectProperties rbrace
    ;

ObjectProperties
    : ObjectProperties comma ObjectProperty
    | ObjectProperty
    | empty
    ;

ObjectProperty
    : string_literal colon string_literal
    | string_literal colon int
    ;

CallBlock
    : call ident lparen Arguments rparen
    ;

Arguments
    : Arguments comma Argument
    | Argument
    | empty
    ;

Argument
    : string_literal
    | int
    | ident
    ;

ThenBlock
    : then Expression
    ;

Expression
    : string_literal as ident
    | int as ident
    | Object as ident
    | TestOperation Operation string_literal
    | TestOperation Operation int
    | TestOperation Operation ident
    ;

TestOperation
    : output
    | result
    | ident dot ident
    ;

Operation
    : equals
    | not_equals
    | contains
    ;
